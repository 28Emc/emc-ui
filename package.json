{
  "name": "emc-packages",
  "version": "0.0.1",
  "description": "EMC UI monorepo - ng-ui (Angular) + emc-ui (agnostic)",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "serve": "ng serve demo",
    "build": "turbo run build",
    "build:ng-ui": "turbo run build --filter=@emc-dev/ng-ui",
    "build:emc-ui": "turbo run build --filter=@emc-dev/emc-ui",
    "build:demo": "ng build demo",
    "build:styles": "tailwindcss -i packages/ng-ui/src/lib/styles/theme.css -o packages/ng-ui/styles.css",
    "analyze": "pnpm -r run analyze",
    "watch": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --storybook-build-dir storybook-static --exit-zero-on-changes",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "peerDependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@lucide/angular": "^1.28.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.28.0",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular-eslint/builder": "^22.1.0",
    "@changesets/cli": "^2.31.1",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/angular-vite": "^10.5.5",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^22.1.0",
    "chromatic": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.2"
  },
  "sideEffects": false
}
