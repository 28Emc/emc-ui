{
  "name": "emc-ui",
  "version": "0.0.1",
  "description": "Custom Angular UI library.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "serve": "ng serve demo",
    "build": "ng build",
    "build:ui": "ng build ui && node scripts/export-styles.mjs",
    "build:demo": "ng build demo",
    "build:styles": "tailwindcss -i projects/ui/src/lib/styles/theme.css -o projects/ui/styles.css",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ui",
    "test:watch": "ng test ui --watch",
    "storybook": "pnpm build:styles && storybook dev -p 6006",
    "build-storybook": "pnpm build:styles && storybook build",
    "chromatic": "chromatic --storybook-build-dir storybook-static --exit-zero-on-changes",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:ui && cd dist/ui && pnpm publish --no-git-checks"
  },
  "peerDependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@lucide/angular": "^1.28.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.28.0",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@changesets/cli": "^2.31.1",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/angular-vite": "^10.5.5",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^22.1.0",
    "chromatic": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.2"
  },
  "sideEffects": false
}
