{
  "name": "emc-packages",
  "version": "0.0.1",
  "description": "EMC UI - framework-agnostic web component library (@emc-dev/emc-ui)",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:emc-ui": "turbo run build --filter=@emc-dev/emc-ui",
    "analyze": "pnpm -r run analyze",
    "watch": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
