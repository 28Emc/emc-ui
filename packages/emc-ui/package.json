{
  "name": "@emc-dev/emc-ui",
  "version": "1.0.1",
  "description": "Framework-agnostic UI components — vanilla TS, Lit, Tailwind CSS v4, Floating UI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ui",
    "components",
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "analyze": "esbuild-visualizer --metadata dist/metafile-esm.json --filename dist/stats.html",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@preact/signals-core": "^1.5.0",
    "clsx": "^2.1.1",
    "lit": "^3.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.0",
    "axe-core": "^4.13.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.1.0",
    "lit": "^3.0.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  },
  "sideEffects": true
}
